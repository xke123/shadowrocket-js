#!name=Shadowrocket Capability Test
#!desc=Test Shadowrocket JS file/share/Shortcuts URL Scheme capabilities

[Script]
CapabilityTest = type=http-response, pattern=^https:\/\/httpbin\.org\/get(?:\?.*)?$, requires-body=0, script-path=https://raw.githubusercontent.com/xke123/shadowrocket-js/main/shadowrocket-capability-test.js

[MITM]
hostname = %APPEND% httpbin.org
